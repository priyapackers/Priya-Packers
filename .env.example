# Neon PostgreSQL connection string from Vercel/Neon integration
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Generate with: npm run admin:hash-password -- 'your-password'
ADMIN_PASSWORD_HASH="pbkdf2_sha256$210000$..."

# Generate a long random value for signing admin session cookies
SESSION_SECRET="replace-with-a-long-random-secret"
